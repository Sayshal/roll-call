<section
  class="rc-blade rc-card {{#if card.active}}is-active{{/if}} {{#if card.onDeck}}is-ondeck{{/if}} {{#if card.defeated}}is-defeated{{/if}} {{#if card.hidden}}is-hidden{{/if}} {{#if card.first}}is-first{{/if}}"
  data-combatant-id="{{card.id}}" {{#if card.canDrag}}draggable="true"
  {{/if}}style="order: {{card.order}}; --roll-call-depth: {{card.depth}}; --roll-call-disposition: {{card.disposition}}">
  <div class="rc-blade-body rc-card-body" data-action="activate" data-combatant-id="{{card.id}}">
    <div class="rc-card-art {{#if card.obscured}}is-obscured{{/if}}" style="background-image: url('{{card.img}}')"></div>
    {{#if card.active}}
      <div class="rc-sweep"></div>
    {{/if}}
    {{#if card.defeated}}
      <div class="rc-slash"></div>
    {{/if}}
    <div class="rc-stripe"></div>
    {{#if card.targeted}}
      <div class="rc-target" data-tooltip aria-label="{{localize 'ROLLCALL.Dock.Targeted'}}"><i
          class="fa-solid fa-location-crosshairs" aria-hidden="true"></i></div>
    {{/if}}
    <div class="rc-init {{#unless card.rolled}}is-unrolled{{/unless}}"><span
        class="rc-upright">{{card.initiative}}</span></div>
    {{#if card.onDeck}}
      <div class="rc-chip rc-chip-ondeck"><span class="rc-upright">{{localize "ROLLCALL.Dock.OnDeck"}}</span></div>
    {{else if card.hidden}}
      <div class="rc-chip rc-chip-hidden"><span class="rc-upright"><i class="fa-solid fa-eye-slash"
            aria-hidden="true"></i> {{localize "ATLAS.Common.Hidden"}}</span></div>
    {{/if}}
    {{#if card.effects.length}}
      <div class="rc-effects rc-upright">
        {{#each card.effects}}<img src="{{img}}" alt="{{name}}" data-tooltip="{{name}}">{{/each}}
      </div>
    {{/if}}
    {{#if card.stack}}{{> rcStack stack=card.stack upright="rc-upright"}}{{/if}}
    <div class="rc-plate">
      {{#if card.legendary}}{{> rcLegendary legendary=card.legendary upright="rc-upright"}}{{/if}}
      <div class="rc-upright rc-name">{{card.name}}</div>
      {{#if (or card.group card.stack.count)}}
        <div class="rc-upright rc-group">{{card.group}}{{#if card.stack.count}} ×{{card.stack.count}}{{/if}}</div>
      {{/if}}
    </div>
    {{#if card.health}}
      <div class="rc-hp">
        <div class="rc-hp-fill is-{{card.health.tier}}"
          style="width: {{card.health.percent}}%;{{#if card.health.color}} background: {{card.health.color}};{{/if}}">
        </div>
        {{#if card.health.temp}}
          <div class="rc-hp-temp" style="width: {{card.health.temp}}%"></div>
        {{/if}}
      </div>
    {{else if card.estimate}}
      <div class="rc-hp rc-hp-estimate is-{{card.estimate.tier}}"
        {{#if card.estimate.color}}style="color: {{card.estimate.color}}" {{/if}}><span
          class="rc-upright">{{card.estimate.label}}</span></div>
    {{/if}}
  </div>
  <div class="rc-btnrow">{{#each card.buttons}}{{> rcSeg}}{{/each}}</div>
</section>
